history_delete_fzf() {
    local selected
    local commands

    if [[ ! -t 0 ]]; then
        # Command supplied through stdin
        commands=$(cat)
    else
        # Interactive fzf picker
        selected=$(
            history |
            fzf --multi \
                --tac \
                --height=60% \
                --reverse \
                --prompt='Delete history > ' \
                --bind='ctrl-a:select-all'
        )

        [[ -z "$selected" ]] && return

        commands=$(printf '%s\n' "$selected" |
            sed 's/^ *[0-9]* *//')
    fi

    while IFS= read -r command; do
        [[ -z "$command" ]] && continue

        history -d "$(history | awk -v cmd="$command" '
            {
                line=$0
                sub(/^ *[0-9]+ */, "", line)
                if (line == cmd) {
                    print $1
                    exit
                }
            }
        ')"
    done <<< "$commands"

    history -w
}

