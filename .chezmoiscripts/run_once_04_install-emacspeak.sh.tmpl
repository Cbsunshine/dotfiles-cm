#!/usr/bin/env bash
set -euo pipefail

PACKAGE="emacspeak"
STOW_DIR="$HOME/.local/stow"
SRC_DIR="$STOW_DIR/src/emacspeak"

# Already installed?
if [[ -d "$STOW_DIR/$PACKAGE" ]] &&
   [ -f  "$STOW_DIR/emacspeak/lisp/emacspeak-setup.el" ] ; then
    echo "Emacspeak is already installed."
    exit 0
fi


# Clone Emacspeak if necessary.
if [[ ! -d "$SRC_DIR/emacspeak/lisp" ]]; then
    git clone https://github.com/tvraman/emacspeak.git "$SRC_DIR"
fi

cd "$SRC_DIR"

# Configure Emacspeak.
#sudo
make config

# Build.
make -j"$(nproc)"

# Install into the Stow package directory.
#sudo
rm -rf "$STOW_DIR/$PACKAGE"
#sudo
mkdir -p "$STOW_DIR/$PACKAGE"
#sudo
cp -a "$SRC_DIR" "$STOW_DIR/$PACKAGE"/

# Activate the package.
cd "$STOW_DIR"

if [[ -e "$STOW_DIR/$PACKAGE" ]]; then
    #sudo
    stow -D "$PACKAGE" 2>/dev/null || true
fi

#sudo
stow "$PACKAGE"

echo "Emacspeak installed and stowed."
