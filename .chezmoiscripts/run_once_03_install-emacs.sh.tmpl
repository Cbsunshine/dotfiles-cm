#!/usr/bin/env bash
set -euo pipefail

PACKAGE="emacs-31"
STOW_DIR="$HOME/.local/stow"
SRC_DIR="$HOME/.local/stow/src/emacs"

# Already installed and stowed?
if command -v emacs >/dev/null 2>&1 &&
   [[ -d "$STOW_DIR/$PACKAGE" ]]; then
    echo "Emacs is already installed."
    exit 0
fi

mkdir -p "$SRC_DIR"
mkdir -p "$STOW_DIR"

# Clone Emacs if necessary.
if [[ ! -d "$HOME/.local/bin/emacs" ]]; then
    git clone https://github.com/emacs-mirror/emacs "$SRC_DIR"
fi

cd "$SRC_DIR"

./autogen.sh

./configure \
    --prefix="$STOW_DIR/$PACKAGE" \
    --with-native-compilation=aot \
    --with-tree-sitter \
    --with-modules \
    --with-rsvg \
    --with-imagemagick \
    --with-x-toolkit=gtk3

make -j"$(nproc)"

sudo make install

cd "$STOW_DIR"

# Don't overwrite an existing Stow package.
if [[ -e "$STOW_DIR/$(basename "$PACKAGE")" ]]; then
    stow -D "$PACKAGE" || true
fi

stow "$PACKAGE"

echo "Emacs installed and stowed as $PACKAGE."
