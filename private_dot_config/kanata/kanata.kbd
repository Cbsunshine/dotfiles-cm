;; ============================================================
;; KANATA CONFIGURATION
;;
;; Space held = SYMBOL layer
;; Tab held   = NUMPAD layer
;;
;; HOME ROW MODIFIERS
;;
;; Left:
;;   A = Super
;;   S = Shift
;;   D = Alt
;;   F = Ctrl
;;
;; Right:
;;   J = Ctrl
;;   K = Alt
;;   L = Shift
;;   ; = Super
;;
;; Caps Lock is completely untouched.
;; ============================================================


(defcfg
  process-unmapped-keys yes
)


;; ------------------------------------------------------------
;; Timing
;; ------------------------------------------------------------

(defvar
  hold-time 200
)


;; ------------------------------------------------------------
;; SOURCE
;; ------------------------------------------------------------

(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m , . /
  spc tab
)


;; ------------------------------------------------------------
;; SYMBOL ALIASES
;;
;; These are actual shifted key combinations.
;; ------------------------------------------------------------

(defalias

  ;; Number-row symbols

  sym1 S-1
  sym2 S-2
  sym3 S-3
  sym4 S-4
  sym5 S-5
  sym6 S-6
  sym7 S-7
  sym8 S-8

  ;; < and >
  less S-,
  greater S-.

  ;; Other programming symbols
  backtick `
  tilde S-`
  backslash \
  minus -
)


;; ------------------------------------------------------------
;; HOME ROW MODIFIERS
;; ------------------------------------------------------------

(defalias

  a-mod
    (tap-hold 200 $hold-time a lmet)

  s-mod
    (tap-hold 200 $hold-time s lsft)

  d-mod
    (tap-hold 200 $hold-time d lalt)

  f-mod
    (tap-hold 200 $hold-time f lctl)


  j-mod
    (tap-hold 200 $hold-time j rctl)

  k-mod
    (tap-hold 200 $hold-time k ralt)

  l-mod
    (tap-hold 200 $hold-time l rsft)

  semicolon-mod
    (tap-hold 200 $hold-time ; rmet)


  ;; ----------------------------------------------------------
  ;; SPACE = SYMBOL LAYER
  ;; ----------------------------------------------------------

  symbol-layer
    (tap-hold 225 225 spc
      (layer-while-held symbols))


  ;; ----------------------------------------------------------
  ;; TAB = NUMPAD LAYER
  ;; ----------------------------------------------------------

  number-layer
    (tap-hold 225 225 tab
      (layer-while-held numpad))
)


;; ============================================================
;; BASE LAYER
;; ============================================================

(deflayer base

  q        w        e        r        t        y        u        i        o        p

  @a-mod   @s-mod   @d-mod   @f-mod   g        h        @j-mod   @k-mod   @l-mod   @semicolon-mod

  z        x        c        v        b        n        m        ,        .        /

  @symbol-layer    @number-layer
)


;; ============================================================
;; SYMBOL LAYER
;;
;; HOLD SPACE
;;
;; Q = !
;; W = @
;; E = #
;; R = $
;; T = %
;;
;; A = <
;; S = >
;;
;; D = ^
;; F = &
;; G = *
;;
;; Z = `
;; X = ~
;; C = \
;; V = -
;;
;; Brackets are intentionally NOT included.
;; ============================================================

(deflayer symbols

  @sym1    @sym2    @sym3    @sym4    @sym5    _        _        _        _        _

  @less    @greater @sym6    @sym7    @sym8    _        _        _        _        _

  @backtick @tilde  @backslash -       _        _        _        _        _        _

  _        _
)


;; ============================================================
;; NUMPAD LAYER
;;
;; HOLD TAB
;;
;;          U   I   O
;;          7   8   9
;;
;;          J   K   L
;;          4   5   6
;;
;;          N   M   ,
;;          3   2   1
;;
;;              .
;;              0
;; ============================================================

(deflayer numpad

  _        _        _        _        _        _        7        8        9        _

  _        _        _        _        _        _        4        5        6        _

  _        _        _        _        _        _        3        2        1        _

  _        _
)
